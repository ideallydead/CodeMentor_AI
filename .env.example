# Database Configuration
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/codementor

# Authentication Security
JWT_SECRET=changeme123

# Cloud LLM Multi-Provider Routing Settings (Global Defaults)
LLM_PROVIDER=together
LLM_MODEL=deepseek-coder

# Multi-Provider Cloud API Keys (Together AI, Groq, Fireworks AI)
TOGETHER_API_KEY=your_together_api_key_here
GROQ_API_KEY=your_groq_api_key_here
FIREWORKS_API_KEY=your_fireworks_api_key_here

# Per-Agent Specialized Model & Provider Allocations (Optional)
# If omitted, agents default to LLM_PROVIDER and LLM_MODEL above.
# MENTOR_AGENT_PROVIDER=groq
# MENTOR_AGENT_MODEL=openai/gpt-oss-120b
# OPTIMIZATION_AGENT_PROVIDER=groq
# OPTIMIZATION_AGENT_MODEL=qwen/qwen3.8-27b
# VIVA_AGENT_PROVIDER=groq
# VIVA_AGENT_MODEL=openai/gpt-oss-120b
# TESTCASE_AGENT_PROVIDER=groq
# TESTCASE_AGENT_MODEL=qwen/qwen3.6-27b
# ASSESSMENT_AGENT_PROVIDER=groq
# ASSESSMENT_AGENT_MODEL=openai/gpt-oss-20b

# Execution Timeout Settings
SANDBOX_TIMEOUT_SECONDS=10

