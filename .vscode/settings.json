            "matchCommandLine": true
        },
        "/^python -m pytest backend/agents/test_mentor_agent\\.py -v --tb=short$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^python -m pytest backend/agents/test_assessment_agent\\.py backend/agents/test_mentor_agent\\.py -v --tb=line 2>&1 \\| tail -30$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^python -m pytest backend/agents/test_assessment_agent\\.py backend/agents/test_mentor_agent\\.py -v --tb=line$/": {
            "approve": true,
            "matchCommandLine": true
        }
